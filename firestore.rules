rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Registered User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['name', 'phone', 'email']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'avatarUrl', 'phone', 'isOnline', 'currentLocation']);
      allow delete: if isOwner(userId);
    }

    // Friendships: Only participants can access or mutate
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn() && 
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    // Live Location Sharing Sessions: Strict Zero-Leakage Privacy
    // Only the broadcaster and explicitly authorized confirmed friends can read live coordinates!
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.allowedFriendIds.hasAny([request.auth.uid])
      );
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.lastLocation != null;
      allow update: if isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLocation', 'isActive', 'expiresAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User Safety Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow update: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
